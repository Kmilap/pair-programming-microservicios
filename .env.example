# ==============================================================
# .env.example — Plantilla de variables de entorno
# Copiar a .env y reemplazar valores reales (NUNCA commitear .env)
# ==============================================================

# ----------------------------
# PostgreSQL — Auth
# ----------------------------
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=auth_pass_change_me

# ----------------------------
# PostgreSQL — Pair Programming
# ----------------------------
POSTGRES_PP_DB=pp_db
POSTGRES_PP_USER=pp_user
POSTGRES_PP_PASSWORD=pp_pass_change_me

# ----------------------------
# PostgreSQL — AI Engine
# ----------------------------
POSTGRES_AI_DB=ai_db
POSTGRES_AI_USER=ai_user
POSTGRES_AI_PASSWORD=ai_pass_change_me

# ----------------------------
# RabbitMQ
# ----------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin_change_me

# ----------------------------
# JWT (compartido entre Auth y otros servicios para validar)
# ----------------------------
JWT_SECRET=replace_with_long_random_string_at_least_32_chars
JWT_TTL=60

# ===== Configuración Auth (stateless) =====
# Auth es stateless por diseño (Fase 1, secciones 1.3 y 5.3).
# - CACHE_STORE=array: cache en memoria del request, descartado al terminar.
# - JWT_BLACKLIST_ENABLED=false: invalidación vía TTL corto + rotación de JWT_SECRET.
# Justificación arquitectónica: el patrón SSO con JWT requiere que cada
# microservicio pueda validar tokens sin consultar storage compartido.
# La blacklist de tymon/jwt-auth contradice este principio.

# ----------------------------
# Laravel APP_KEYs (por servicio)
# ----------------------------
AUTH_APP_KEY=base64:replace_with_php_artisan_key_generate_output

# ----------------------------
# Anthropic API (usado por AI Engine, Día 5)
# ----------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-5

# ----------------------------
# Frontend
# ----------------------------
VITE_API_BASE_URL=http://localhost
