# ============================================================
# .gitignore — Pair Programming Microservicios
# ============================================================

# Variables de entorno (NUNCA commitear)
.env
.env.local
.env.*.local
*.env

# Dependencias
node_modules/
vendor/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Builds y caches
dist/
build/
.next/
.cache/
.parcel-cache/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
bootstrap/cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Laravel específico
/public/hot
/public/storage
/.phpunit.result.cache
auth.json

# PHP
*.phar

# Docker (datos persistentes generados por volúmenes locales si los usaras)
docker-data/

# Compilaciones de TypeScript
*.tsbuildinfo

# API Keys (defensa adicional contra commits accidentales)
*api-key*
*apikey*
*.secret
secrets/